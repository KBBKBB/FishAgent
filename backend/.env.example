# FishAgent MVP configuration. Copy to .env and fill in only when testing real providers.
# Mock mode needs no keys at all.
FISHAGENT_MOCK_MODE=true
FISHAGENT_HOST=127.0.0.1
FISHAGENT_PORT=8000

# AMap Web Service key (server side only, never ship to the browser)
AMAP_WEB_KEY=your-amap-web-service-key

# Real-mode request pacing; tune both to your AMap quota.
FISHAGENT_AMAP_CONCURRENCY=6
FISHAGENT_AMAP_QPS=2

# Open-Meteo needs no key for the non-commercial tier.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenAI-compatible LLM (empty means deterministic fallback routing)
# DeepSeek example: LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- CR-05 photo fish identification (POST /api/agent/identify-fish) ---------
# Vision model for the image endpoint. Empty falls back to LLM_MODEL; the
# configured model must accept image input (e.g. an image-capable deployment).
# DeepSeek example: LLM_VISION_MODEL=deepseek-flash
LLM_VISION_MODEL=
FISHAGENT_IDENTIFY_MAX_UPLOAD_BYTES=8388608
FISHAGENT_IDENTIFY_MAX_SIDE=1280
FISHAGENT_IDENTIFY_TIMEOUT_SECONDS=60
# Bound on simultaneous photo decodes. A 48 MP photo peaks around 356 MB of
# RSS, so this is a memory limit: 2 slots keeps the worst case near ~700 MB.
FISHAGENT_IDENTIFY_MAX_CONCURRENT_DECODES=2

# --- CR-04 community species (Step 3 "推荐鱼种") -----------------------------
# mock = deterministic demo data; none = always "暂无相关鱼种推荐";
# bing = match species from Bing result titles/snippets (Phase 1, no page crawl).
# Empty means mock in Mock mode and none in real mode.
FISHAGENT_SPECIES_PROVIDER=
FISHAGENT_SPECIES_TIMEOUT_SECONDS=4
FISHAGENT_SPECIES_CACHE_TTL_SECONDS=3600
# Phase 2: fetch top result pages for extra species. Works without an LLM
# (whitelist matching); with LLM_API_KEY set it also uses LLM extraction.
FISHAGENT_SPECIES_PAGE_FETCH=false

# --- CR-03 pilot access (leave disabled for S1) -----------------------------
# Turning this on REQUIRES a public HTTPS origin and both secrets below.
FISHAGENT_PUBLIC_ACCESS_ENABLED=false
# Shared invitation code for 3-5 pilot users; use 12+ random characters.
FISHAGENT_PILOT_INVITE_CODE=replace-with-a-long-random-invite-code
# HMAC key for signed cookies; use 32+ random bytes, rotate to revoke all logins.
FISHAGENT_PILOT_TOKEN_SECRET=replace-with-at-least-32-random-characters
FISHAGENT_PILOT_TOKEN_TTL_SECONDS=43200
FISHAGENT_PILOT_COOKIE_NAME=fishagent_pilot
FISHAGENT_PILOT_COOKIE_SECURE=true
# Comma-separated explicit origins; empty means same-origin only. Never use *.
FISHAGENT_PILOT_CORS_ORIGINS=
# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
FISHAGENT_PILOT_TRUST_PROXY_HEADERS=false
FISHAGENT_PILOT_RATE_LIMIT_IP_PER_MINUTE=60
FISHAGENT_PILOT_RATE_LIMIT_TOKEN_PER_MINUTE=60
FISHAGENT_PILOT_LOGIN_ATTEMPTS_PER_MINUTE=10

# D4 daily upstream budgets; the app returns 429 before exceeding them.
FISHAGENT_AMAP_DAILY_QUOTA=2000
FISHAGENT_LLM_DAILY_QUOTA=200
FISHAGENT_OPEN_METEO_DAILY_QUOTA=1000
FISHAGENT_QUOTA_DAY_TIMEZONE=Asia/Shanghai
